# Copy to .env and `set -a; source .env; set +a` before running, or export individually.
CAREFLOW_SECRET=change-me-to-a-long-random-string
# Speech recognition model size: tiny | base | small (default) | medium
CAREFLOW_ASR_MODEL=small
# CAREFLOW_ASR=off   # disable speech recognition
# CAREFLOW_OCR=off   # disable OCR
# Optional small language model (any OpenAI-compatible endpoint, <20B model recommended)
# CAREFLOW_SLM_URL=http://localhost:11434/v1
# CAREFLOW_SLM_MODEL=qwen2.5:7b-instruct
# Location of the synthetic dataset (defaults to ../careflow_dataset)
# CAREFLOW_DATASET=/path/to/careflow_dataset
